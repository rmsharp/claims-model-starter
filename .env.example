# Model Project Constructor — environment variable template
#
# Copy this file to `.env` (which is git-ignored) and fill in the values
# appropriate for your deployment. The orchestrator reads these via
# `OrchestratorSettings.from_env()` — see `src/model_project_constructor/
# orchestrator/config.py` for the loader and `OPERATIONS.md` for the full
# runbook.
#
# None of these values have safe defaults for credentials. The app will
# refuse to start any live-host run without an explicit token.

# -----------------------------------------------------------------------
# Host selection
# -----------------------------------------------------------------------
# Which git host the Website Agent targets. One of: gitlab, github.
MPC_HOST=gitlab

# API base URL. If unset, defaults to the public host for the selected
# platform (https://gitlab.com or https://api.github.com). Set this to
# your enterprise instance URL for self-hosted deployments.
#MPC_HOST_URL=https://gitlab.example.com

# Target group (GitLab) or org/owner (GitHub) where the Website Agent
# will create the project. Must be a PATH, never a URL. E.g.
# `rmsharp-modelpilot` or `data-science/model-drafts`, NOT
# `https://gitlab.com/rmsharp-modelpilot` — the adapter looks up the
# group by path, so a URL here surfaces as an unhelpful 404. The
# orchestrator rejects URL-prefixed values at config-load time with
# a clear error.
#MPC_NAMESPACE=rmsharp-modelpilot

# -----------------------------------------------------------------------
# Host credentials (exactly one is required for a live run)
# -----------------------------------------------------------------------
# GitLab personal access token with `api` scope + create_project
# permission on MPC_NAMESPACE.
#GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitHub personal access token (classic or fine-grained) with `repo`
# scope on the target owner/org.
#GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------
# Anthropic (required by agents that call Claude)
# -----------------------------------------------------------------------
# Required by: Intake Agent (web UI + real interviews), Data Agent (QC
# generation), any runner wiring that invokes Anthropic directly.
#ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------
# LLM provider selection (Intake Agent web UI)
# -----------------------------------------------------------------------
# Which LLM backend the Intake Agent uses. One of: anthropic (default),
# bedrock (AWS-hosted Claude via the bedrock-mantle endpoint). Read by
# src/model_project_constructor/ui/intake/app.py.
#INTAKE_LLM_PROVIDER=anthropic

# Optional model-id override. When unset, each provider uses its own
# default (anthropic -> Sonnet; bedrock -> the bare Bedrock id
# anthropic.claude-opus-4-8). On the bedrock-mantle path use the BARE id,
# never a us./eu./global. inference-profile prefix (those are classic
# bedrock-runtime only).
#INTAKE_LLM_MODEL=anthropic.claude-opus-4-8

# -----------------------------------------------------------------------
# AWS Bedrock (only when INTAKE_LLM_PROVIDER=bedrock)
# -----------------------------------------------------------------------
# The Bedrock client (AnthropicBedrockMantle) self-discovers AWS auth from
# the standard credential chain and signs with SigV4 — so in production it
# needs NO static keys: run under an IAM role (IRSA / instance profile /
# ECS task role / SSO) and set only AWS_REGION. Full enterprise deployment
# guide (least-privilege IAM policy, PrivateLink, data residency):
# docs/deployment/bedrock-enterprise.md.
#
# Region -> selects the bedrock-mantle.{region}.api.aws endpoint host and
# the data-residency geography. Must be a mantle-supported region.
#AWS_REGION=us-east-1
#AWS_DEFAULT_REGION=us-east-1
#
# PrivateLink without Private DNS only: override the endpoint host to the
# VPCE DNS name. Read directly by the SDK's mantle client (lib/bedrock/
# _mantle.py) -- no app code involved, nothing in this repo wires it. NOT
# the same var as ANTHROPIC_BASE_URL (that's the plain anthropic.Anthropic
# client's env var, not read by AnthropicBedrockMantle). Leave unset when
# Private DNS is enabled (the default endpoint already resolves privately).
#ANTHROPIC_BEDROCK_MANTLE_BASE_URL=https://{vpce-id}.bedrock-mantle.{region}.vpce.amazonaws.com/anthropic
#
# DEV ONLY: a SHORT-TERM Bedrock API key (aws-bedrock-token-generator).
# LEAVE THIS UNSET IN PRODUCTION — if present it overrides SigV4 and
# silently bypasses your IAM role. Never use a long-term Bedrock API key.
# The SDK also honors ANTHROPIC_AWS_API_KEY as an alternate name for the
# same bearer token — leave that unset in production too.
#AWS_BEARER_TOKEN_BEDROCK=
#ANTHROPIC_AWS_API_KEY=
#
# PRODUCTION: set this to make BedrockLLMClient reject construction with a
# hard error if either bearer-token var above is set, instead of silently
# falling back to bearer auth (D13). Accepts 1/true/yes/on.
#BEDROCK_REQUIRE_SIGV4=1

# -----------------------------------------------------------------------
# Orchestrator runtime
# -----------------------------------------------------------------------
# Root directory for the checkpoint store. Each run creates a
# subdirectory named after its `run_id`. Defaults to
# `./.orchestrator/checkpoints`.
#MPC_CHECKPOINT_DIR=/var/lib/mpc/checkpoints

# Stdlib logging level for the orchestrator namespace. One of:
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
#MPC_LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# Generated-project CI portability (enterprise hosts) — Phase C3b
# -----------------------------------------------------------------------
# These override the CI/pre-commit config the Website Agent's governance
# scaffold bakes INTO EACH GENERATED PROJECT — NOT this repository's own
# CI. Read directly by scripts/run_pipeline.py's build_ci_host_config()
# (and threaded through --ci-* flags on the website agent CLI), not via
# OrchestratorSettings. Leave unset to keep today's public defaults:
# Docker Hub's python:3.11, public PyPI, the public GitHub Actions
# marketplace, and the public astral-sh/ruff-pre-commit mirror.
#MPC_CI_BASE_IMAGE=registry.enterprise.example/python:3.11
#MPC_CI_INDEX_URL=https://pypi.enterprise.example/simple
#MPC_CI_ACTION_PREFIX=enterprise-mirror
#MPC_CI_PRE_COMMIT_REPO=https://git.enterprise.example/mirrors/ruff-pre-commit

# -----------------------------------------------------------------------
# Intake Agent web UI (optional — only needed by the FastAPI UI)
# -----------------------------------------------------------------------
# Path to the SQLite file where live interview sessions are checkpointed.
# Defaults to `./intake_sessions.db` in the working directory.
#INTAKE_DB_PATH=/var/lib/mpc/intake_sessions.db
